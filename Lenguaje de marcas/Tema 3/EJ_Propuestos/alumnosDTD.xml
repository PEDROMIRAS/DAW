<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE school [
    <!ELEMENT school (student+)>
    <!ELEMENT student (name, age)>
    <!ATTLIST student id ID #REQUIRED>
    <!ATTLIST student status (Active | Inactive | Graduated) #IMPLIED>
    <!ELEMENT name (#PCDATA)>
    <!ELEMENT age (#PCDATA)>
]>
<school>
    <student id="a1" status="Active">
        <name>John Doe</name>
        <age>20</age>
    </student>
    <student id="a2">
        <name>Jane Doe</name>
        <age>21</age>
    </student>
    <student id="a3" status="Graduated">
        <name>John Smith</name>
        <age>22</age>
    </student>
    <student id="a4" status="Inactive">
        <name>Jane Smith</name>
        <age>23</age>
    </student>
</school>